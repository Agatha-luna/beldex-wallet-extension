{
  "name": "beldex-wallet-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Beldex wallet browser extension (Manifest V3) built on the Beldex LWS wasm core",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "webpack --mode=production",
    "build:firefox": "webpack --mode=production --env firefox",
    "package": "bash scripts/package.sh",
    "build:testnet": "npm run build:chrome:testnet && npm run build:firefox:testnet",
    "build:chrome:testnet": "webpack --mode=production --env network=testnet",
    "build:firefox:testnet": "webpack --mode=production --env firefox --env network=testnet",
    "dev": "webpack --mode=development --watch",
    "dev:testnet": "webpack --mode=development --env network=testnet --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --disallow-code-generation-from-strings --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@bdxi/beldex-app-bridge": "3.0.1",
    "@fontsource/michroma": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "copy-webpack-plugin": "^14.0.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.4.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
